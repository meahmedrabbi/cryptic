# -----------------------------------------------------------------------
# Copy this file to .env and fill in every value before starting the app.
# -----------------------------------------------------------------------

# Flask secret key (used for session signing)
SECRET_KEY=change-me-to-a-random-string

# Set to "true" only in development
FLASK_DEBUG=false

# SQLite (default) or any SQLAlchemy-compatible URL
# Example PostgreSQL: postgresql://user:pass@localhost/gateway
DATABASE_URL=sqlite:///gateway.db

# Fernet encryption key for private keys stored in the database.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Bearer token required for admin endpoints (/api/payments, /dashboard)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=

# HMAC secret used to sign outgoing webhook payloads
# Verify on your server: X-Gateway-Signature header == HMAC-SHA256(body, WEBHOOK_SECRET)
WEBHOOK_SECRET=

# TronGrid API key (free at https://www.trongrid.io/)
TRONGRID_API_KEY=

# BSCScan API key (free at https://bscscan.com/apis)
BSCSCAN_API_KEY=

# USDT contract addresses (defaults are mainnet – change for testnet)
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# Minutes before an unpaid invoice is automatically expired
INVOICE_EXPIRY_MINUTES=30

# Minimum block confirmations before an invoice is marked "paid"
TRC20_CONFIRMATIONS=20
BEP20_CONFIRMATIONS=12

# How often (seconds) the background monitor polls the blockchain
POLL_INTERVAL=20

# Port the Flask dev server listens on (gunicorn ignores this)
PORT=5000
